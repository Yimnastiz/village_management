{
  "name": "village-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "setup:db": "node scripts/setup.mjs --database-only",
    "identity:backfill": "node scripts/backfill-resident-identity.mjs",
    "identity:duplicate-report": "node scripts/report-duplicate-identity.mjs",
    "population:legacy-registration-report": "node scripts/report-legacy-registration-person-placeholders.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "catalog:prepare": "node scripts/prepare-thailand-villages.mjs",
    "catalog:import": "node scripts/import-thailand-villages.mjs",
    "catalog:backfill-moo": "node scripts/backfill-thailand-village-moo.mjs",
    "catalog:analyze-duplicates": "node scripts/analyze-village-duplicates.mjs",
    "catalog:status": "node scripts/catalog-status.mjs",
    "catalog:setup": "npm run catalog:prepare && npm run catalog:import && npm run catalog:status",
    "catalog:import:demo": "node scripts/import-thailand-villages.mjs data/demo/thailand-villages.demo.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "better-auth": "^1.5.5",
    "clsx": "^2.1.1",
    "geothai": "^3.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.1.7",
    "pg": "^8.16.3",
    "prisma": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
