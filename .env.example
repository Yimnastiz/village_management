# Local development database started by `npm run db:up`.
DATABASE_URL="postgresql://village_user:village_password@localhost:55432/village_management?schema=public"

# Local-only values. Replace BETTER_AUTH_SECRET with a strong secret before deployment.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="local-development-only-change-before-production"
# Development only: explicit origins for testing from devices on the LAN.
# Include every dev-server port that may be used; do not set this in production.
# BETTER_AUTH_DEV_ORIGINS="http://192.168.1.41:3000,http://192.168.1.41:3001"
# Used only once to create the first Super Admin. Replace before any production deployment.
SUPERADMIN_BOOTSTRAP_SECRET="change-this-before-running-setup"

# Optional development helpers. Do not enable these in production.
# DEV_SHOW_OTP="true"
# DEV_BYPASS_OTP="true"
# DEV_OTP_CODE="000000"
