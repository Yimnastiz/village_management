# Local development database started by `npm run db:up`.
DATABASE_URL="postgresql://village_user:village_password@localhost:55432/village_management?schema=public"

# Local-only values. Replace BETTER_AUTH_SECRET with a strong secret before deployment.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="local-development-only-change-before-production"

# Email delivery. `console` is for local development only and is rejected in
# production. Use `smtp` with the SMTP settings below for deployed systems.
EMAIL_PROVIDER="console"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Email OTP security and abuse controls. Set an independent, strong
# EMAIL_OTP_HASH_SECRET in production; the BETTER_AUTH_SECRET fallback is
# available only outside production.
EMAIL_OTP_TTL_SECONDS="300"
EMAIL_OTP_MAX_ATTEMPTS="5"
EMAIL_OTP_RESEND_SECONDS="60"
EMAIL_OTP_MAX_RESENDS="5"
EMAIL_OTP_RATE_WINDOW_SECONDS="900"
EMAIL_OTP_MAX_REQUESTS_PER_EMAIL="5"
EMAIL_OTP_MAX_REQUESTS_PER_IP="20"
EMAIL_OTP_HASH_SECRET=""

# Signs the unified email-login flow cookie. Production should set an
# independent value; non-production may fall back to BETTER_AUTH_SECRET.
ACCOUNT_LOGIN_FLOW_SECRET=""

# Signs the short-lived HTTP-only cookie that authorizes an applicant to
# verify, resend, inspect, or cancel their own House Account opening request.
# Required explicitly in production; non-production may fall back to BETTER_AUTH_SECRET.
HOUSE_ACCOUNT_OPENING_ACCESS_SECRET=""
# Development only: explicit origins for testing from devices on the LAN.
# Include every dev-server port that may be used; do not set this in production.
# Replace <your-lan-ip> with the current IPv4 address of the development machine.
# BETTER_AUTH_DEV_ORIGINS="http://<your-lan-ip>:3000"
# Optional production object storage for Place images (S3/R2 compatible).
# Without these values, development stores files under data/uploads/.
PLACE_UPLOAD_SECRET=""
PLACE_UPLOAD_S3_BUCKET=""
PLACE_UPLOAD_S3_REGION=""
PLACE_UPLOAD_S3_ENDPOINT=""
PLACE_UPLOAD_S3_ACCESS_KEY_ID=""
PLACE_UPLOAD_S3_SECRET_ACCESS_KEY=""
PLACE_UPLOAD_S3_FORCE_PATH_STYLE="false"

# Optional development helpers. Do not enable these in production.
# DEV_SHOW_OTP="true"
# DEV_BYPASS_OTP="true"
# DEV_OTP_CODE="000000"
# Development only. Skips Thai national ID checksum validation while still requiring exactly 13 numeric digits.
DEV_BYPASS_THAI_NATIONAL_ID_CHECK=false

# Setup-only bootstrap inputs. Set these only while provisioning the first
# configured Village and Headman, then remove them from the operator environment.
# The configured catalog identity is committed in config/installation-village.json.
# Bootstrap derives the Village name, route, moo, and location from that catalog row.
# BOOTSTRAP_HEADMAN_NAME="<headman name>"
# Required for the initial Headman login.
# BOOTSTRAP_HEADMAN_EMAIL="<headman-login-email>"
# Optional contact information only; it is not used to authenticate.
# BOOTSTRAP_HEADMAN_PHONE="<thai-10-digit-contact-phone>"
