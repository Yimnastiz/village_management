# Local development database started by `npm run db:up`.
DATABASE_URL="postgresql://village_user:village_password@localhost:55432/village_management?schema=public"

# Local-only values. Replace BETTER_AUTH_SECRET with a strong secret before deployment.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="local-development-only-change-before-production"
# Development only: explicit origins for testing from devices on the LAN.
# Include every dev-server port that may be used; do not set this in production.
# Replace <your-lan-ip> with the current IPv4 address of the development machine.
# BETTER_AUTH_DEV_ORIGINS="http://<your-lan-ip>:3000"
# Super Admin access is ENV-only. Use long, randomly generated secrets; never commit real values.
SUPERADMIN_ACCESS_CODE=""
SUPERADMIN_SESSION_SECRET=""

# Optional production object storage for Place images (S3/R2 compatible).
# Without these values, development stores files under data/uploads/.
PLACE_UPLOAD_SECRET=""
PLACE_UPLOAD_S3_BUCKET=""
PLACE_UPLOAD_S3_REGION=""
PLACE_UPLOAD_S3_ENDPOINT=""
PLACE_UPLOAD_S3_ACCESS_KEY_ID=""
PLACE_UPLOAD_S3_SECRET_ACCESS_KEY=""
PLACE_UPLOAD_S3_FORCE_PATH_STYLE="false"

# Optional development helpers. Do not enable these in production.
# DEV_SHOW_OTP="true"
# DEV_BYPASS_OTP="true"
# DEV_OTP_CODE="000000"
# Development only. Skips Thai national ID checksum validation while still requiring exactly 13 numeric digits.
DEV_BYPASS_THAI_NATIONAL_ID_CHECK=false
