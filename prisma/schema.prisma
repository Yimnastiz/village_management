generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========

enum SystemRole {
  SUPERADMIN
  USER
}

enum VillageMembershipRole {
  HEADMAN
  ASSISTANT_HEADMAN
  COMMITTEE
  RESIDENT
}

enum RegistrationMode {
  RESIDENT
  HEADMAN
}

enum RegistrationTempStatus {
  WAITING_OTP
  VERIFIED
  REJECTED
  CANCELLED
}

enum RegistrationOtpChallengeStatus {
  PENDING_SEND
  ACTIVE
  SEND_FAILED
  CONSUMED
}

enum AccountStatus {
  ACTIVE
  DELETION_PENDING
  DUPLICATE_ID
  ANONYMIZED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum BindingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NewsStage {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsVisibility {
  PUBLIC
  RESIDENT_ONLY
}

enum NewsSubmissionType {
  CREATE
  UPDATE
}

enum NewsSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VillageEventSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VillageEventSubmissionType {
  CREATE
  EDIT
  DELETE
}

enum VillagePlaceCategory {
  TEMPLE
  SHOP
  FOOD
  SERVICE
  SCHOOL
  CLINIC
  GOVERNMENT
  COMMUNITY
  AGRICULTURE
  ACCOMMODATION
  TRANSPORT
  OTHER
}

enum VillagePlaceSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VillagePlaceSubmissionType {
  CREATE
  UPDATE
}

enum IssueStage {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  REJECTED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueCategory {
  ROAD
  WATER
  ELECTRICITY
  WASTE
  SECURITY
  PUBLIC_HEALTH
  ENVIRONMENT
  OTHER
}

enum AppointmentStage {
  PENDING_APPROVAL
  TIME_SUGGESTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum CorrectionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DownloadStage {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TransparencyStage {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PopulationImportStage {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ISSUE_UPDATE
  APPOINTMENT_UPDATE
  NEWS
  BINDING_REQUEST
  CORRECTION_REQUEST
  EMERGENCY
  SOS
  SYSTEM
}

enum FileOwnerType {
  ISSUE
  ISSUE_MESSAGE
  APPOINTMENT
  CORRECTION_REQUEST
  BINDING_REQUEST
  DOWNLOAD
  TRANSPARENCY
  GALLERY
  NEWS
  PERSON
  HOUSE
  IMPORT_JOB
}

enum FileAccessScope {
  PUBLIC
  RESIDENT
  ADMIN
}

enum HouseholdOccupancyStatus {
  OCCUPIED
  VACANT
  UNDER_CONSTRUCTION
  DEMOLISHED
}

enum PersonStatus {
  ACTIVE
  DECEASED
  MOVED_OUT
  UNKNOWN
}

enum MovementType {
  MOVE_IN
  MOVE_OUT
  BIRTH
  DEATH
  TRANSFER
}

enum FeedbackRating {
  VERY_SATISFIED
  SATISFIED
  NEUTRAL
  DISSATISFIED
  VERY_DISSATISFIED
}

enum GalleryItemSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmergencyType {
  FIRE
  FLOOD
  ACCIDENT
  MEDICAL
  CRIME
  OTHER
}

enum EmergencyBroadcastStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum AuditAction {
  VIEW_SENSITIVE
  EXPORT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  POPULATION_IMPORT_STARTED
  POPULATION_IMPORT_VALIDATED
  POPULATION_IMPORT_CONFIRMED
  POPULATION_IMPORT_COMPLETED
  POPULATION_IMPORT_PARTIAL
  POPULATION_IMPORT_FAILED
  POPULATION_IMPORT_ROLLBACK
  POPULATION_EXPORT_CREATED
  VILLAGE_CREATED_FROM_CATALOG
  VILLAGE_CREATED_MANUAL
  VILLAGE_CATALOG_IMPORTED
  VILLAGE_CATALOG_UPDATED
  APPROVE_RESIDENT_WITH_NATIONAL_ID
  REVOKE_DUPLICATE_NATIONAL_ID_ACCOUNT
  RELEASE_PHONE_FROM_REVOKED_ACCOUNT
}

enum HouseSourceType {
  ADMIN_CREATED
  IMPORT
  RESIDENT_REQUEST_VERIFIED
  SUPERADMIN_CREATED
  SEED
}

// ========== MODELS ==========

model User {
  id                         String        @id @default(cuid())
  phoneNumber                String        @unique
  phoneNumberVerified        Boolean       @default(false)
  name                       String
  email                      String?       @unique
  emailVerified              Boolean       @default(false)
  image                      String?
  systemRole                 SystemRole    @default(USER)
  registrationProvince       String?
  registrationDistrict       String?
  registrationSubdistrict    String?
  registrationVillageId      String?
  citizenVerifiedAt          DateTime?
  consentAt                  DateTime?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  accountStatus              AccountStatus @default(ACTIVE)
  duplicateOfUserId          String?
  duplicateResolvedAt        DateTime?
  duplicateReason            String?
  duplicateNoticeLoginUsedAt DateTime?
  duplicateNoticeSeenAt      DateTime?
  deletionRequestedAt        DateTime?
  scheduledDeletionAt        DateTime?
  anonymizedAt               DateTime?
  deletionRecoveryHash       String?

  authSessions            AuthSession[]
  authAccounts            AuthAccount[]
  registrationTemps       RegistrationTemp[]       @relation("RegistrationTempOwner")
  memberships             VillageMembership[]
  person                  Person?
  bindingRequests         BindingRequest[]
  contactRequests         ContactRequest[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  sosCases                EmergencySOS[]
  savedItems              SavedItem[]
  authoredNews            News[]
  newsSubmissions         NewsSubmission[]
  villageEventSubmissions VillageEventSubmission[]
  villageEventsCreated    VillageEvent[]
  galleryItemSubmissions  GalleryItemSubmission[]
  villagePlacesCreated    VillagePlace[]
  villagePlaceSubmissions VillagePlaceSubmission[]
  appointments            Appointment[]
  appointmentActions      AppointmentTimeline[]
  registrationVillage     Village?                 @relation("UserRegistrationVillage", fields: [registrationVillageId], references: [id])

  @@index([phoneNumber])
}

model AuthSession {
  id              String   @id @default(cuid())
  userId          String
  token           String   @unique
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  activeVillageId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  village Village? @relation(fields: [activeVillageId], references: [id])

  @@index([userId])
  @@index([token])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Village {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  moo              String?
  description      String?
  address          String?
  district         String?
  province         String?
  subdistrict      String?
  phone            String?
  email            String?
  website          String?
  sourceNote       String?
  catalogVillageId String?  @unique(map: "village_catalog_village_id_key")
  logoUrl          String?
  bannerUrl        String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships             VillageMembership[]
  zones                   VillageZone[]
  houses                  House[]
  news                    News[]
  newsSubmissions         NewsSubmission[]
  issues                  Issue[]
  appointments            Appointment[]
  appointmentSlots        AppointmentSlot[]
  downloads               DownloadFile[]
  transparencyRecords     TransparencyRecord[]
  villageEvents           VillageEvent[]
  villageEventSubmissions VillageEventSubmission[]
  villagePlaces           VillagePlace[]
  villagePlaceSubmissions VillagePlaceSubmission[]
  galleryAlbums           GalleryAlbum[]
  contactDirectories      ContactDirectory[]
  contactRequests         ContactRequest[]
  faqItems                FAQItem[]
  notifications           Notification[]
  emergencyBroadcasts     EmergencyBroadcast[]
  emergencyLocations      EmergencyLocation[]
  authSessions            AuthSession[]
  correctionRequests      HouseholdCorrectionRequest[]
  importJobs              PopulationImportJob[]
  auditLogs               AuditLog[]
  registeredUsers         User[]                       @relation("UserRegistrationVillage")
  phoneRoleSeeds          PhoneRoleSeed[]
  bindingRequests         BindingRequest[]
  catalogVillage          ThailandVillageMaster?       @relation(fields: [catalogVillageId], references: [id], onDelete: SetNull)

  @@unique([province, district, subdistrict, moo], map: "village_area_moo_key")
  @@index([slug])
}

model ThailandVillageMaster {
  id                    String    @id @default(cuid())
  officialCode          String?   @unique(map: "tvm_official_code_key")
  lookupKey             String?   @unique(map: "tvm_lookup_key")
  villageName           String
  normalizedName        String?
  moo                   String?
  slug                  String?   @unique(map: "tvm_slug_key")
  provinceCode          String?
  province              String
  normalizedProvince    String?
  districtCode          String?
  district              String
  normalizedDistrict    String?
  subdistrictCode       String?
  subdistrict           String
  normalizedSubdistrict String?
  latitude              Float?
  longitude             Float?
  populationTotal       Int?
  malePopulation        Int?
  femalePopulation      Int?
  householdCount        Int?
  sourceName            String?
  sourceUrl             String?
  sourceUpdatedAt       DateTime?
  importedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  village Village?

  @@unique([province, district, subdistrict, villageName, moo], map: "tvm_area_name_moo_key")
  @@index([province, district, subdistrict], map: "tvm_area_idx")
  @@index([provinceCode, districtCode, subdistrictCode], map: "tvm_area_code_idx")
  @@index([normalizedProvince, normalizedDistrict, normalizedSubdistrict], map: "tvm_norm_area_idx")
  @@index([villageName], map: "tvm_village_name_idx")
  @@index([normalizedName], map: "tvm_norm_name_idx")
  @@index([province, district, subdistrict, villageName], map: "tvm_area_name_idx")
}

model VillageMembership {
  id        String                @id @default(cuid())
  userId    String
  villageId String
  role      VillageMembershipRole @default(RESIDENT)
  status    MembershipStatus      @default(PENDING)
  houseId   String?
  joinedAt  DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  house   House?  @relation(fields: [houseId], references: [id])

  @@unique([userId, villageId])
  @@index([userId])
  @@index([villageId])
  @@index([status])
}

model VillageZone {
  id          String   @id @default(cuid())
  villageId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  houses  House[]

  @@index([villageId])
}

model House {
  id                    String                   @id @default(cuid())
  villageId             String
  zoneId                String?
  houseNumber           String
  normalizedHouseNumber String
  address               String?
  occupancyStatus       HouseholdOccupancyStatus @default(OCCUPIED)
  sourceType            HouseSourceType          @default(ADMIN_CREATED)
  sourceNote            String?
  verifiedByUserId      String?
  verifiedAt            DateTime?
  latitude              Float?
  longitude             Float?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  village            Village                      @relation(fields: [villageId], references: [id], onDelete: Cascade)
  zone               VillageZone?                 @relation(fields: [zoneId], references: [id])
  persons            Person[]
  memberships        VillageMembership[]
  bindingRequests    BindingRequest[]
  correctionRequests HouseholdCorrectionRequest[]
  movementHistory    PersonMovement[]

  @@unique([villageId, normalizedHouseNumber])
  @@index([villageId])
}

model Person {
  id           String       @id @default(cuid())
  userId       String?      @unique
  houseId      String?
  villageId    String?
  nationalId   String?
  firstName    String
  lastName     String
  dateOfBirth  DateTime?
  gender       String?
  phone        String?
  email        String?
  status       PersonStatus @default(ACTIVE)
  profilePhoto String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  house     House?           @relation(fields: [houseId], references: [id])
  movements PersonMovement[]

  @@index([houseId])
  @@index([nationalId])
}

model PersonMovement {
  id           String       @id @default(cuid())
  personId     String
  houseId      String?
  movementType MovementType
  date         DateTime
  note         String?
  createdAt    DateTime     @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  house  House? @relation(fields: [houseId], references: [id])

  @@index([personId])
  @@index([houseId])
}

model BindingRequest {
  id          String               @id @default(cuid())
  userId      String
  villageId   String?
  houseId     String?
  houseNumber String?
  note        String?
  status      BindingRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  village Village? @relation(fields: [villageId], references: [id])
  house   House?   @relation(fields: [houseId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([villageId])
}

model News {
  id          String         @id @default(cuid())
  villageId   String
  title       String
  content     String         @db.Text
  summary     String?
  coverUrl    String?
  imageUrls   Json?
  stage       NewsStage      @default(DRAFT)
  visibility  NewsVisibility @default(PUBLIC)
  isPinned    Boolean        @default(false)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  village     Village          @relation(fields: [villageId], references: [id], onDelete: Cascade)
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  targets     NewsTarget[]
  reads       NewsRead[]
  savedItems  SavedItem[]
  submissions NewsSubmission[]

  @@index([villageId])
  @@index([stage])
  @@index([publishedAt])
}

model NewsSubmission {
  id           String               @id @default(cuid())
  villageId    String
  requesterId  String
  type         NewsSubmissionType
  status       NewsSubmissionStatus @default(PENDING)
  targetNewsId String?
  payload      Json
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  village    Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  requester  User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  targetNews News?   @relation(fields: [targetNewsId], references: [id], onDelete: SetNull)

  @@index([villageId])
  @@index([requesterId])
  @@index([status])
  @@index([type])
}

model NewsTarget {
  id       String @id @default(cuid())
  newsId   String
  targetId String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, targetId])
}

model NewsRead {
  id     String   @id @default(cuid())
  newsId String
  userId String
  readAt DateTime @default(now())

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@index([userId])
}

model Issue {
  id          String        @id @default(cuid())
  villageId   String
  reporterId  String
  title       String
  description String        @db.Text
  imageUrls   Json?
  isPublic    Boolean       @default(false)
  category    IssueCategory @default(OTHER)
  priority    IssuePriority @default(MEDIUM)
  stage       IssueStage    @default(OPEN)
  assigneeId  String?
  location    String?
  latitude    Float?
  longitude   Float?
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  village    Village         @relation(fields: [villageId], references: [id], onDelete: Cascade)
  messages   IssueMessage[]
  timeline   IssueTimeline[]
  feedback   IssueFeedback?
  savedItems SavedItem[]

  @@index([villageId])
  @@index([reporterId])
  @@index([stage])
  @@index([category])
  @@index([isPublic])
}

model IssueMessage {
  id         String   @id @default(cuid())
  issueId    String
  senderId   String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueTimeline {
  id          String   @id @default(cuid())
  issueId     String
  actorId     String?
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueFeedback {
  id        String         @id @default(cuid())
  issueId   String         @unique
  userId    String
  rating    FeedbackRating
  comment   String?
  createdAt DateTime       @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppointmentSlot {
  id          String   @id @default(cuid())
  villageId   String
  date        DateTime @db.Date
  startTime   String
  endTime     String
  maxCapacity Int      @default(1)
  isBlocked   Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  village      Village       @relation(fields: [villageId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([villageId])
  @@index([date])
}

model Appointment {
  id          String           @id @default(cuid())
  villageId   String
  slotId      String?
  userId      String
  title       String
  description String?
  stage       AppointmentStage @default(PENDING_APPROVAL)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  scheduledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  village  Village               @relation(fields: [villageId], references: [id], onDelete: Cascade)
  slot     AppointmentSlot?      @relation(fields: [slotId], references: [id])
  timeline AppointmentTimeline[]

  @@index([villageId])
  @@index([userId])
  @@index([stage])
}

model AppointmentTimeline {
  id            String   @id @default(cuid())
  appointmentId String
  actorId       String?
  action        String
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

model HouseholdCorrectionRequest {
  id          String                  @id @default(cuid())
  villageId   String
  userId      String
  houseId     String?
  subject     String
  description String                  @db.Text
  status      CorrectionRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  house   House?  @relation(fields: [houseId], references: [id])

  @@index([villageId])
  @@index([userId])
  @@index([status])
}

model DownloadFile {
  id            String         @id @default(cuid())
  villageId     String
  title         String
  description   String?
  category      String?
  categoryLabel String?
  stage         DownloadStage  @default(DRAFT)
  visibility    NewsVisibility @default(PUBLIC)
  fileKey       String?
  fileUrl       String?
  fileSize      Int?
  mimeType      String?
  downloadCount Int            @default(0)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  village    Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  savedItems SavedItem[]
  attachments DownloadAttachment[]

  @@index([villageId])
  @@index([stage])
  @@index([visibility])
  @@index([category])
}

model DownloadAttachment {
  id            String   @id @default(cuid())
  downloadId    String
  fileName      String
  fileKey       String?
  fileUrl       String
  fileSize      Int
  mimeType      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  download DownloadFile @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@index([downloadId, sortOrder])
}

model TransparencyRecord {
  id          String            @id @default(cuid())
  villageId   String
  title       String
  description String?           @db.Text
  category    String?
  amount      Float?
  fiscalYear  String?
  stage       TransparencyStage @default(DRAFT)
  visibility  NewsVisibility    @default(PUBLIC)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  village    Village     @relation(fields: [villageId], references: [id], onDelete: Cascade)
  savedItems SavedItem[]

  @@index([villageId])
  @@index([stage])
  @@index([visibility])
}

model VillageEvent {
  id          String    @id @default(cuid())
  villageId   String
  createdById String?
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([villageId])
  @@index([createdById])
  @@index([startsAt])
  @@index([isPublic])
}

model VillageEventSubmission {
  id          String                       @id @default(cuid())
  villageId   String
  requesterId String
  title       String
  description String?                      @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isPublic    Boolean                      @default(false)
  type        VillageEventSubmissionType   @default(CREATE)
  eventId     String?
  status      VillageEventSubmissionStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([villageId])
  @@index([requesterId])
  @@index([status])
  @@index([eventId])
  @@index([startsAt])
}

model VillagePlace {
  id           String               @id @default(cuid())
  villageId    String
  name         String
  category     VillagePlaceCategory @default(OTHER)
  description  String?              @db.Text
  address      String?
  openingHours String?
  contactPhone String?
  mapUrl       String?
  latitude     Float?
  longitude    Float?
  imageUrls    Json?
  isPublic     Boolean              @default(true)
  isFeatured   Boolean              @default(false)
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  village    Village             @relation(fields: [villageId], references: [id], onDelete: Cascade)
  createdBy  User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  images     VillagePlaceImage[]
  savedItems SavedItem[]

  @@index([villageId])
  @@index([category])
  @@index([isPublic])
  @@index([isFeatured])
}

model VillagePlaceImage {
  id        String   @id @default(cuid())
  placeId   String
  url       String   @db.Text
  fileKey   String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  place VillagePlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
}

model VillagePlaceSubmission {
  id              String                       @id @default(cuid())
  villageId       String
  requesterId     String
  type            VillagePlaceSubmissionType   @default(CREATE)
  targetPlaceId   String?
  approvedPlaceId String?
  payload         Json
  status          VillagePlaceSubmissionStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([villageId])
  @@index([requesterId])
  @@index([type])
  @@index([targetPlaceId])
  @@index([approvedPlaceId])
  @@index([status])
}

model GalleryAlbum {
  id                       String   @id @default(cuid())
  villageId                String
  title                    String
  description              String?
  coverUrl                 String?
  albumDate                DateTime
  isPublic                 Boolean  @default(true)
  allowResidentSubmissions Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  village         Village                 @relation(fields: [villageId], references: [id], onDelete: Cascade)
  items           GalleryItem[]
  itemSubmissions GalleryItemSubmission[]
  savedItems      SavedItem[]

  @@index([villageId])
  @@index([albumDate])
}

model GalleryItem {
  id                 String   @id @default(cuid())
  albumId            String
  title              String?
  fileUrl            String
  fileKey            String?
  mimeType           String?
  sortOrder          Int      @default(0)
  isCover            Boolean  @default(false)
  sourceSubmissionId String?  @unique
  createdAt          DateTime @default(now())

  album            GalleryAlbum          @relation(fields: [albumId], references: [id], onDelete: Cascade)
  sourceSubmission GalleryItemSubmission? @relation("GalleryItemSourceSubmission", fields: [sourceSubmissionId], references: [id], onDelete: SetNull)

  @@index([albumId])
  @@index([albumId, sortOrder])
}

model GalleryItemSubmission {
  id           String                      @id @default(cuid())
  albumId      String
  requesterId  String
  batchId      String?
  batchOrder   Int?
  title        String?
  fileUrl      String
  fileKey      String?
  mimeType     String?
  note         String?
  status       GalleryItemSubmissionStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  album        GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  requester    User         @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  approvedItem GalleryItem? @relation("GalleryItemSourceSubmission")

  @@index([albumId])
  @@index([requesterId])
  @@index([status])
  @@index([batchId])
  @@index([albumId, batchId])
}

model ContactDirectory {
  id         String      @id @default(cuid())
  savedItems SavedItem[]
  villageId  String
  name       String
  role       String?
  phone      String?
  email      String?
  address    String?
  category   String?
  sortOrder  Int         @default(0)
  isPublic   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
}

// The durable workflow record for a resident's requested directory contact.
// Notifications only point here; their read/archive state is not request state.
model ContactRequest {
  id                String               @id
  villageId         String
  requesterId       String
  name              String
  role              String?
  phone             String
  email             String?
  address           String?
  category          String?
  note              String?
  status            ContactRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  rejectReason      String?
  approvedContactId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([villageId, status])
  @@index([requesterId, createdAt])
  @@index([approvedContactId])
}

model FAQItem {
  id        String   @id @default(cuid())
  villageId String?
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  village Village? @relation(fields: [villageId], references: [id])

  @@index([villageId])
}

model FileObject {
  id          String          @id @default(cuid())
  ownerType   FileOwnerType
  ownerId     String
  accessScope FileAccessScope @default(RESIDENT)
  fileKey     String
  fileUrl     String?
  fileName    String
  mimeType    String?
  fileSize    Int?
  uploadedBy  String?
  createdAt   DateTime        @default(now())

  @@index([ownerType, ownerId])
  @@index([fileKey])
}

model PopulationImportJob {
  id            String                @id @default(cuid())
  villageId     String
  createdBy     String
  fileName      String
  fileKey       String?
  stage         PopulationImportStage @default(PENDING)
  totalRows     Int                   @default(0)
  importedRows  Int                   @default(0)
  failedRows    Int                   @default(0)
  createdRows   Int                   @default(0)
  updatedRows   Int                   @default(0)
  skippedRows   Int                   @default(0)
  conflictRows  Int                   @default(0)
  errors        Json?
  sourceRows    Json?
  confirmedBy   String?
  confirmedAt   DateTime?
  supportReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
  @@index([stage])
}

model Notification {
  id        String             @id @default(cuid())
  villageId String?
  userId    String
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  village Village? @relation(fields: [villageId], references: [id])

  @@index([userId])
  @@index([status])
}

model EmergencyBroadcast {
  id         String                   @id @default(cuid())
  villageId  String
  title      String
  content    String                   @db.Text
  type       EmergencyType            @default(OTHER)
  status     EmergencyBroadcastStatus @default(ACTIVE)
  createdBy  String?
  resolvedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
  @@index([status])
}

model EmergencySOS {
  id         String        @id @default(cuid())
  villageId  String?
  userId     String
  message    String?
  latitude   Float?
  longitude  Float?
  type       EmergencyType @default(OTHER)
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([villageId])
}

model EmergencyLocation {
  id          String   @id @default(cuid())
  villageId   String
  name        String
  description String?
  type        String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  village Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
}

model AuditLog {
  id         String      @id @default(cuid())
  villageId  String?
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  village Village? @relation(fields: [villageId], references: [id])

  @@index([userId])
  @@index([villageId])
  @@index([action])
  @@index([createdAt])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum LoginOtpChallengeStatus {
  PENDING_SEND
  ACTIVE
  VERIFYING
  SEND_FAILED
  LOCKED
  CONSUMED
}

model LoginOtpChallenge {
  id                  String                  @id @default(cuid())
  phoneNumber         String                  @unique
  otpIdentifier       String
  challengeToken      String                  @unique
  status              LoginOtpChallengeStatus @default(PENDING_SEND)
  otpSentAt           DateTime?
  otpExpiresAt        DateTime?
  resendAvailableAt   DateTime?
  failedAttempts      Int                     @default(0)
  lockedUntil         DateTime?
  sendWindowStartedAt DateTime
  sendCount           Int                     @default(0)
  ipHash              String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status])
  @@index([lockedUntil])
}

model RegistrationTemp {
  id               String                 @id @default(cuid())
  userId           String?
  phoneNumber      String
  registrationMode RegistrationMode       @default(RESIDENT)
  name             String
  firstName        String?
  lastName         String?
  nationalId       String
  province         String
  district         String
  subdistrict      String
  villageId        String
  callbackUrl      String?
  status           RegistrationTempStatus @default(WAITING_OTP)
  rejectReason     String?
  rejectedAt       DateTime?
  otpSentAt        DateTime?
  otpResendCount   Int                    @default(0)
  otpFailedCount   Int                    @default(0)
  otpLastAttemptAt DateTime?
  otpLockedUntil   DateTime?
  expiresAt        DateTime
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User?                  @relation("RegistrationTempOwner", fields: [userId], references: [id], onDelete: SetNull)
  verifierSessions RegistrationVerifierSession[]

  @@index([userId])
  @@index([phoneNumber])
  @@index([status])
  @@index([expiresAt])
}

model RegistrationOtpChallenge {
  id                  String                         @id @default(cuid())
  phoneNumber         String                         @unique
  otpIdentifier       String
  status              RegistrationOtpChallengeStatus @default(PENDING_SEND)
  otpSentAt           DateTime?
  otpExpiresAt        DateTime?
  resendAvailableAt   DateTime?
  resendCount         Int                            @default(0)
  sendWindowStartedAt DateTime
  sendCount           Int                            @default(0)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@index([status])
}

model RegistrationVerifierSession {
  id             String    @id @default(cuid())
  registrationId String
  ipHash         String
  failedAttempts Int       @default(0)
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  registration RegistrationTemp @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

model AccountDeletionChallenge {
  id                String    @id @default(cuid())
  userId            String    @unique
  phoneNumber       String
  otpSentAt         DateTime
  otpExpiresAt      DateTime
  resendAvailableAt DateTime
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([otpExpiresAt])
}

model PhoneRoleSeed {
  id                String                @id @default(cuid())
  phoneNumber       String                @unique
  villageId         String?
  membershipRole    VillageMembershipRole @default(RESIDENT)
  systemRole        SystemRole?
  isCitizenVerified Boolean               @default(true)
  note              String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  village Village? @relation(fields: [villageId], references: [id], onDelete: SetNull)

  @@index([villageId])
}

model SavedItem {
  id             String   @id @default(cuid())
  userId         String
  newsId         String?
  downloadId     String?
  issueId        String?
  galleryAlbumId String?
  transparencyId String?
  contactId      String?
  placeId        String?
  createdAt      DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  news               News?               @relation(fields: [newsId], references: [id])
  download           DownloadFile?       @relation(fields: [downloadId], references: [id])
  issue              Issue?              @relation(fields: [issueId], references: [id])
  galleryAlbum       GalleryAlbum?       @relation(fields: [galleryAlbumId], references: [id])
  transparencyRecord TransparencyRecord? @relation(fields: [transparencyId], references: [id])
  contact            ContactDirectory?   @relation(fields: [contactId], references: [id])
  place              VillagePlace?       @relation(fields: [placeId], references: [id])

  @@unique([userId, newsId])
  @@unique([userId, downloadId])
  @@unique([userId, issueId])
  @@unique([userId, galleryAlbumId])
  @@unique([userId, transparencyId])
  @@unique([userId, contactId])
  @@unique([userId, placeId])
  @@index([userId])
}
