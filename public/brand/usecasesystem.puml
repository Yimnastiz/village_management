@startuml
left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam usecase {
    BackgroundColor white
    BorderColor black
    ArrowColor black
}
skinparam rectangle {
    BackgroundColor white
    BorderColor black
}

actor "บุคคลทั่วไป" as Guest
actor "สมาชิก" as Resident
actor "ผู้ใหญ่บ้าน" as Headman

rectangle "ระบบบริหารจัดการหมู่บ้าน" {

    ' =========================
    ' บุคคลทั่วไป
    ' =========================
    usecase "ลงทะเบียนและ\nยืนยันหมายเลขโทรศัพท์" as UC01
    usecase "เรียกดูข้อมูลสาธารณะ\nของหมู่บ้าน" as UC02
    usecase "ส่งข้อเสนอแนะ\nร้องเรียน หรือรายงานข้อผิดพลาด" as UC03

    ' =========================
    ' สมาชิก
    ' =========================
    usecase "เข้าสู่ระบบ" as UC04
    usecase "จัดการคำขอ\nผูกบัญชีกับบ้าน" as UC05
    usecase "เรียกดูข้อมูลข่าวสาร\nและข้อมูลของหมู่บ้าน" as UC06
    usecase "เรียกดูข้อมูลครัวเรือน" as UC07
    usecase "แจ้งปัญหาและ\nติดตามการดำเนินงาน" as UC08
    usecase "ส่งและจัดการ\nคำขอนัดหมาย" as UC09
    usecase "ส่งคำขอข้อมูล\nเพื่อให้ผู้ใหญ่บ้านพิจารณา" as UC10
    usecase "จัดการรายการที่บันทึกไว้" as UC11
    usecase "จัดการการแจ้งเตือน" as UC12
    usecase "จัดการข้อมูลโปรไฟล์" as UC13

    ' =========================
    ' ผู้ใหญ่บ้าน
    ' =========================
    usecase "พิจารณาคำขอ\nผูกบัญชีกับบ้าน" as UC14
    usecase "จัดการสมาชิก" as UC15
    usecase "จัดการข้อมูลบ้าน\nและประชากร" as UC16
    usecase "จัดการข่าวสารและ\nข้อมูลบริการหมู่บ้าน" as UC17
    usecase "พิจารณาคำขอข้อมูล\nจากสมาชิก" as UC18
    usecase "จัดการรายการแจ้งปัญหา" as UC19
    usecase "จัดการการนัดหมาย\nและช่วงเวลานัดหมาย" as UC20
    usecase "จัดการข้อเสนอแนะ\nร้องเรียน และรายงานข้อผิดพลาด" as UC21
    usecase "จัดการประกาศหมู่บ้าน" as UC22
    usecase "ตรวจสอบบันทึกกิจกรรม" as UC23
    usecase "จัดการการตั้งค่า\nหมู่บ้านและระบบ" as UC24
}

' =========================
' ความสัมพันธ์ของบุคคลทั่วไป
' =========================
Guest -- UC01
Guest -- UC02
Guest -- UC03

' =========================
' ความสัมพันธ์ของสมาชิก
' =========================
Resident -- UC04
Resident -- UC05
Resident -- UC06
Resident -- UC07
Resident -- UC08
Resident -- UC09
Resident -- UC10
Resident -- UC11
Resident -- UC12
Resident -- UC13

' =========================
' ความสัมพันธ์ของผู้ใหญ่บ้าน
' =========================
Headman -- UC04
Headman -- UC14
Headman -- UC15
Headman -- UC16
Headman -- UC17
Headman -- UC18
Headman -- UC19
Headman -- UC20
Headman -- UC21
Headman -- UC22
Headman -- UC23
Headman -- UC24

@enduml
